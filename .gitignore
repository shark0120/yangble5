# ── SECRETS: never commit. The upstream yangble5 install keeps live OAuth
# tokens and API keys next to the engine; this repo must stay clean. ──
auth/
*.oauth
config.local.yaml
config.yaml
.env
.env.*
!.env.example
*secret*
# ...but the glob above cannot tell a file that CONTAINS secrets from a
# document ABOUT handling them, and it was silently eating the second kind.
# deploy/SECRETS_SETUP.md is the guide GO_LIVE.md sends you to before you
# supply any upstream credential, and the one smoke_test.sh names when it
# suspects a leak -- so for months every clone of this repo carried four
# dangling pointers to a page that was never shipped, including one an
# operator would follow mid-incident. It holds no credential of any kind;
# CI's own three scans (key shapes, addresses, IPs) run over it like any
# other tracked file. Negate the narrowest possible path, never the glob.
!deploy/SECRETS_SETUP.md
*credential*
*token*.json
!package-lock.json
gateway/data/
*.db
*.sqlite
*.sqlite3
certs/
*.pem
*.key
!**/example*.key

# ── deploy: operator-supplied artifacts ──
# The CLIProxyAPI binary is never committed: we do not redistribute it, and a
# 40MB binary in git history cannot be taken back out.
deploy/engine-bin/*
!deploy/engine-bin/README.md
# Live Caddy drop-ins are the operator's; only the .example is tracked.
deploy/caddy/conf.d/*.conf
# Backups written by harden.sh before it edits a system file.
*.yangble5.bak-*

# ── runtime / generated ──
stats.json
*.tmp
__pycache__/
*.py[cod]
.venv/
venv/
# Per-interpreter environments. CONTRIBUTING asks for a run on the floor version
# before changing anything version-sensitive, and that means a second venv.
.venv*/
venv*/
node_modules/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
logs/
*.log

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# PowerShell writes its module cache under %LOCALAPPDATA%. The installer tests
# redirect that (tests/test_installer_consent.py), but a harness that forgets
# leaves `Microsoft/Windows/PowerShell/ModuleAnalysisCache` in the repo root,
# where one `git add -A` commits a binary nobody meant to ship. Belt to the
# redirect's braces.
Microsoft/Windows/PowerShell/ModuleAnalysisCache
Microsoft/
